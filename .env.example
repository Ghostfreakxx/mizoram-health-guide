# Live video consultations with real doctors (off when empty).
# The domain of the Health Department's self-hosted Jitsi Meet server,
# for example: consult.example.gov.in  (public meet.jit.si is not accepted)
NEXT_PUBLIC_LIVE_CONSULT_DOMAIN=

# Spoken answers (on-device speech recognition only). Off by default; set to
# "on-device" only after testing on the devices that will be used.
NEXT_PUBLIC_VOICE_INPUT=

# Online help understanding the patient's words (off when empty). Server-only
# values: never prefix them with NEXT_PUBLIC_, never commit a real key. Set them
# in the hosting provider's settings (e.g. Vercel → Project → Environment
# Variables), then redeploy. Needs privacy/legal approval before real patients.
AI_UNDERSTANDING=
OPENAI_API_KEY=
# Optional: OPENAI_MODEL (default gpt-5.4-mini), OPENAI_REASONING_EFFORT (default low)
